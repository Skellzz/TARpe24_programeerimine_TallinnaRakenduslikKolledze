@model TallinnaRakenduslikKolledz.Models.Kaebus

@{
	ViewData["Title"] = "View Suspension";
}
<h1>
	Vaata Kaebusi
</h1>
<div>
	<h4>
		Kaebused @Model.Firstname @Model.Lastname
	</h4>
	<dl class="row">
		<dt class="col-sm-2">@Html.DisplayNameFor(Model => Model.StutentId)</dt>
		<dd class="col-sm-10">@Html.DisplayFor(Model => Model.StutentId)</dd>
	</dl>
	<dl class="row">
		<dt class="col-sm-2">@Html.DisplayNameFor(Model => Model.Firstname)</dt>
		<dd class="col-sm-10">@Html.DisplayFor(Model => Model.Firstname)</dd>
	</dl>
	<dl class="row">
		<dt class="col-sm-2">@Html.DisplayNameFor(Model => Model.Lastname)</dt>
		<dd class="col-sm-10">@Html.DisplayFor(Model => Model.Lastname)</dd>
	</dl>
	<dl class="row">
		<dt class="col-sm-2">@Html.DisplayNameFor(Model => Model.ReasonForSuspension)</dt>
		<dd class="col-sm-10">@Html.DisplayFor(Model => Model.ReasonForSuspension)</dd>
	</dl>
	<dl class="row">
		<dt class="col-sm-2">@Html.DisplayNameFor(Model => Model.SuspensionStartDate)</dt>
		<dd class="col-sm-10">@Html.DisplayFor(Model => Model.SuspensionStartDate)</dd>
	</dl>
	<dl class="row">
		<dt class="col-sm-2">@Html.DisplayNameFor(Model => Model.SuspensionEndDate)</dt>
		<dd class="col-sm-10">@Html.DisplayFor(Model => Model.SuspensionEndDate)</dd>
	</dl>
	<dl class="row">
		<dt class="col-sm-2">@Html.DisplayNameFor(Model => Model.NoteForParents)</dt>
		<dd class="col-sm-10">@Html.DisplayFor(Model => Model.NoteForParents)</dd>
	</dl>
</div>
<div class="form-group">
	<a asp-action="Index">Cancel</a>
</div>



