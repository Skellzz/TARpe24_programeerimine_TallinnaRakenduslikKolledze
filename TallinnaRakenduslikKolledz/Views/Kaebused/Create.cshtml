@model TallinnaRakenduslikKolledz.Models.Kaebus

@{

	ViewData["Title"] = "New Suspension";

}
<h1>Loo uus Kaebus</h1>
<hr />
<div class=="row">
	<form asp-action="Create">

		<div asp-validation-summary="ModelOnly" class="text-danger"></div>

		
		<div class="form-group">
			<label asp-for="Firstname" class="control-label"></label>
			<input asp-for="Firstname" class="form-control" />
			<span asp-validation-for="Firstname" class="text-danger"></span>
		</div>
		<div class="form-group">
			<label asp-for="Lastname" class="control-label"></label>
			<input asp-for="Lastname" class="form-control" />
			<span asp-validation-for="Lastname" class="text-danger"></span>
		</div>
		<div class="form-group">
			<label asp-for="ReasonForSuspension" class="control-label"></label>
			<input asp-for="ReasonForSuspension" class="form-control" />
			<span asp-validation-for="ReasonForSuspension" class="text-danger"></span>
		</div>
		<div class="form-group">
			<label asp-for="SuspensionStartDate" class="control-label"></label>
			<input asp-for="SuspensionStartDate" class="form-control" />
			<span asp-validation-for="SuspensionStartDate" class="text-danger"></span>
		</div>
		<div class="form-group">
			<label asp-for="SuspensionEndDate" class="control-label"></label>
			<input asp-for="SuspensionEndDate" class="form-control" />
			<span asp-validation-for="SuspensionEndDate" class="text-danger"></span>
		</div>
		<div class="form-group">
			<label asp-for="NoteForParents" class="control-label"></label>
			<input asp-for="NoteForParents" class="form-control" />
			<span asp-validation-for="NoteForParents" class="text-danger"></span>
		</div>
		
		<divc class="form-group">
			<input type="submit" value="Sisesta" class="btn btn-primary" />
		</divc>
	</form>
</div>

<div>
			<a asp-action="Index">Mine tagasi loendisse</a>
</div>


