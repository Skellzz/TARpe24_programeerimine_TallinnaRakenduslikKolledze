@model IEnumerable<TallinnaRakenduslikKolledz.Models.Kaebus>

@{
	ViewData["Title"] = "Suspensions";
}
<h1> Suspensions </h1>

<p>
	<a asp-action="Create"> Add a new Suspension</a>
</p>

<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(Model => Model.StutentId)
			</th>
			<th>
				@Html.DisplayNameFor(Model => Model.Firstname)
				</th>
			<th>
				@Html.DisplayNameFor(Model => Model.Lastname)
				</th>
			<th>
				@Html.DisplayNameFor(Model => Model.ReasonForSuspension)
				</th>
			<th>
				@Html.DisplayNameFor(Model => Model.SuspensionStartDate)
				</th>
			<th>
				@Html.DisplayNameFor(Model => Model.SuspensionEndDate)
				</th>
			<th>
				@Html.DisplayNameFor(Model => Model.NoteForParents)
				</th>
		</tr>
	</thead>

	<tbody>
		@foreach (var kaebused in Model)
		{
			<tr>
			<td>
				@Html.DisplayFor(modelItem => kaebused.StutentId)
			</td>
			<td>
				@Html.DisplayFor(modelItem => kaebused.Firstname)
			</td>
			<td>
				@Html.DisplayFor(modelItem => kaebused.Lastname)
			</td>
			<td>
				@Html.DisplayFor(modelItem => kaebused.ReasonForSuspension)
			</td>
			<td>
				@Html.DisplayFor(modelItem => kaebused.SuspensionStartDate)
			</td>
			<td>
				@Html.DisplayFor(modelItem => kaebused.SuspensionEndDate)
			</td>
			<td>
				@Html.DisplayFor(modelItem => kaebused.NoteForParents)
			</td>

			<td>
					<a asp-action="Delete" asp-route-id="@kaebused.StutentId">Delete</a>
					<a asp-action="Details" asp-route-id="@kaebused.StutentId">Details</a>
					<a asp-action="Edit" asp-route-id="@kaebused.StutentId">Edit</a>
			</td>
			</tr>
		}
</table>