@model TallinnaRakenduslikKolledz.Models.Kaebus

@{
	ViewData["Title"] = "Editi Kaebuseid";
}

<h1>Kaebused info:</h1>
<hr />
<div class="row">
	<div class="col-md-4">
		<form asp-action="EditConfirmed">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<input type="hidden" asp-for="StutentId" />

			<div class="form-group">
				<label asp-for="Firstname" class="control-label"></label>
				<input asp-for="Firstname" class="form-control"></input>
				<span asp-validation-for="Firstname" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="Lastname" class="control-label"></label>
				<input asp-for="Lastname" class="form-control"></input>
				<span asp-validation-for="Lastname" class="text-danger"></span>
			</div>


			<div class="form-group">
				<label asp-for="ReasonForSuspension" class="control-label"></label>
				<input asp-for="ReasonForSuspension" class="form-control"></input>
				<span asp-validation-for="ReasonForSuspension" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="SuspensionStartDate" class="control-label"></label>
				<input asp-for="SuspensionStartDate" class="form-control"></input>
				<span asp-validation-for="SuspensionStartDate" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="SuspensionEndDate" class="control-label"></label>
				<input asp-for="SuspensionEndDate" class="form-control"></input>
				<span asp-validation-for="SuspensionEndDate" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="NoteForParents" class="control-label"></label>
				<input asp-for="NoteForParents" class="form-control"></input>
				<span asp-validation-for="NoteForParents" class="text-danger"></span>
			</div>

			<div class="form-group">
				<input type="Submit" value="Save Changes" class="btn btn-primary" />
			</div>

			<div class="form-group">
				<a asp-action="Index">Cancel</a>
			</div>

		</form>
	</div>
</div>